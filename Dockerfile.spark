FROM apache/spark:3.5.1

USER root

# Install wget and gosu for user switching
RUN apt-get update && \
    apt-get install -y wget gosu && \
    rm -rf /var/lib/apt/lists/*

# Download and install Kafka connector JAR and dependencies
# Using version 3.5.1 to match Spark version
# Kafka connector requires: kafka-clients, spark-token-provider-kafka-0-10, and commons-pool2
RUN wget -q https://repo1.maven.org/maven2/org/apache/spark/spark-sql-kafka-0-10_2.12/3.5.1/spark-sql-kafka-0-10_2.12-3.5.1.jar -O /opt/spark/jars/spark-sql-kafka-0-10_2.12-3.5.1.jar && \
    wget -q https://repo1.maven.org/maven2/org/apache/spark/spark-token-provider-kafka-0-10_2.12/3.5.1/spark-token-provider-kafka-0-10_2.12-3.5.1.jar -O /opt/spark/jars/spark-token-provider-kafka-0-10_2.12-3.5.1.jar && \
    wget -q https://repo1.maven.org/maven2/org/apache/kafka/kafka-clients/3.5.1/kafka-clients-3.5.1.jar -O /opt/spark/jars/kafka-clients-3.5.1.jar && \
    wget -q https://repo1.maven.org/maven2/org/apache/commons/commons-pool2/2.12.0/commons-pool2-2.12.0.jar -O /opt/spark/jars/commons-pool2-2.12.0.jar && \
    chmod 644 /opt/spark/jars/spark-sql-kafka-0-10_2.12-3.5.1.jar && \
    chmod 644 /opt/spark/jars/spark-token-provider-kafka-0-10_2.12-3.5.1.jar && \
    chmod 644 /opt/spark/jars/kafka-clients-3.5.1.jar && \
    chmod 644 /opt/spark/jars/commons-pool2-2.12.0.jar

# Verify JARs are present
RUN ls -lh /opt/spark/jars/spark-sql-kafka-0-10_2.12-3.5.1.jar && \
    ls -lh /opt/spark/jars/kafka-clients-3.5.1.jar

# Copy entrypoint script
COPY spark-entrypoint.sh /usr/local/bin/spark-entrypoint.sh
RUN chmod +x /usr/local/bin/spark-entrypoint.sh

# Keep as root for entrypoint to fix permissions, then switch to spark user
# USER spark

